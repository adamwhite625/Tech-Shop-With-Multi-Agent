# Application Settings
APP_NAME="TechStore Host Agent"
APP_VERSION="1.0.0"
PORT=8000

# Agent-to-Agent (A2A) Communication URLs
# Khi chạy Docker: dùng tên service (search_agent, advisor_agent, order_agent)
# Khi chạy local: dùng localhost
SEARCH_AGENT_URL="http://search_agent:8001"
ADVISOR_AGENT_URL="http://advisor_agent:8002"
ORDER_AGENT_URL="http://order_agent:8003"

# OpenAI / LLM Keys (For intent routing)
OPENAI_API_KEY=your_openai_api_key_here
